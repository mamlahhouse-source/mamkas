{
  "name": "mamlah-solusi-kelaparan",
  "private": true,
  "version": "3.0.0",
  "description": "MAMLAH - SOLUSI KELAPARAN | Aplikasi Kasir Profesional",
  "author": "MAMLAH",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 3000",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:server": "vite --host 127.0.0.1 --port 5173",
    "electron:dev": "wait-on http://127.0.0.1:5173 && electron .",
    "app": "concurrently -k -r \"npm:dev:server\" \"npm:electron:dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "electron:run": "npm run build && node scripts/run-dist.cjs",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "id.mamlah.kasir",
    "productName": "MAMLAH - SOLUSI KELAPARAN",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "scripts/run-dist.cjs",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MAMLAH",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "icon": "electron/icon.png"
  }
}
